<Window x:Class="FlowLedger.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FlowLedger.Desktop.Localization"
        Title="FlowLedger" Width="1280" Height="900" MinWidth="1040" MinHeight="740"
        Background="#F2F6F8" Foreground="#19333E" WindowStartupLocation="CenterScreen" Icon="Assets/FlowLedger.ico">
  <Grid Background="#F2F6F8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="212" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#142D37">
      <Grid Margin="18,28,18,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="12,0,8,30">
          <Image Source="Assets/FlowLedger.png" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="FlowLedger" />
          <TextBlock Text="FlowLedger" FontSize="25" LineHeight="34" FontWeight="SemiBold" Foreground="#A8EDDA" />
          <TextBlock Text="{DynamicResource BrandSubtitle}" Foreground="#B3C9D0" FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
        <ListBox x:Name="NavigationList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnNavigationChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#DCE9ED" /><Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,13" /><Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="ItemBackground" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter /></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#29534F" /><Setter Property="Foreground" Value="#B9F6E3" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBackground" Property="BorderBrush" Value="#A8EDDA" /><Setter TargetName="ItemBackground" Property="BorderThickness" Value="1" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
          <ListBoxItem Content="{DynamicResource Overview}" /><ListBoxItem Content="{DynamicResource Networks}" />
          <ListBoxItem Content="{DynamicResource Applications}" /><ListBoxItem Content="{DynamicResource Proxy}" />
          <ListBoxItem Content="{DynamicResource Ssh}" /><ListBoxItem Content="{DynamicResource Reports}" /><ListBoxItem Content="{DynamicResource Environment}" />
        </ListBox>
        <StackPanel Grid.Row="2" Margin="12,16,8,0">
          <TextBlock Text="{DynamicResource Version}" Foreground="#B3C9D0" FontSize="12" />
          <TextBlock Text="{DynamicResource LocalOnly}" Foreground="#A8EDDA" FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="145" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0">
          <TextBlock x:Name="PageTitle" FontSize="28" LineHeight="38" FontWeight="SemiBold" />
          <TextBlock x:Name="PageDescription" Style="{StaticResource Hint}" Margin="0,8,0,0" />
        </StackPanel>
        <ComboBox x:Name="LanguagePicker" Grid.Column="1" VerticalAlignment="Top" SelectionChanged="OnLanguageChanged" AutomationProperties.Name="Language / 语言">
          <ComboBoxItem Content="简体中文" /><ComboBoxItem Content="English" />
        </ComboBox>
      </Grid>
      <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="24" BorderBrush="#DCE5E9" BorderThickness="1">
        <Grid>
          <ScrollViewer x:Name="TrafficPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="{Binding CollectionStatus}" Style="{StaticResource Status}" />
              <TextBlock Text="{DynamicResource Interface}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" DisplayMemberPath="Label" AutomationProperties.Name="{DynamicResource Interface}" />
              <TextBlock Text="{Binding InventorySummary}" Style="{StaticResource Hint}" Margin="0,8,0,22" />
              <UniformGrid Columns="2">
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource DownloadRate}" Style="{StaticResource Hint}" /><TextBlock Text="{Binding DownloadRate}" Style="{StaticResource MetricValue}" /></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource UploadRate}" Style="{StaticResource Hint}" /><TextBlock Text="{Binding UploadRate}" Style="{StaticResource MetricValue}" /></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource ReceivedSession}" Style="{StaticResource Hint}" /><TextBlock Text="{Binding DownloadTotal}" Style="{StaticResource MetricValue}" /></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource SentSession}" Style="{StaticResource Hint}" /><TextBlock Text="{Binding UploadTotal}" Style="{StaticResource MetricValue}" /></StackPanel></Border>
              </UniformGrid>
              <Expander Header="{DynamicResource Details}" Margin="0,14,0,0"><TextBlock Text="{Binding QualityStatus}" Style="{StaticResource Hint}" Margin="0,12,0,0" /></Expander>
              <Expander Header="{DynamicResource WifiDetails}" Margin="0,14,0,0"><StackPanel Margin="0,12,0,0">
                <TextBlock Text="{Binding SelectionDetails}" Style="{StaticResource Hint}" />
                <Button Content="{DynamicResource QueryWifi}" IsEnabled="{Binding CanReadWifi}" Click="OnReadWifi" HorizontalAlignment="Left" Margin="0,12,0,10" />
                <TextBlock Text="{Binding WifiInfo}" /><TextBlock Text="{DynamicResource WifiPermission}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
              </StackPanel></Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="WifiLedgerPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="{Binding WifiModeStatus}" Style="{StaticResource Status}" />
              <WrapPanel Margin="0,14,0,14"><Button Content="{DynamicResource EnableWifi}" Click="OnEnableWifi" IsEnabled="{Binding CanEnableWifi}" Margin="0,0,10,6" /><Button Content="{DynamicResource Pause}" Click="OnDisableWifi" IsEnabled="{Binding CanDisableWifi}" Margin="0,0,0,6" /></WrapPanel>
              <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" DisplayMemberPath="Label" AutomationProperties.Name="{DynamicResource Interface}" />
              <TextBlock Text="{Binding WifiAllocationSummary}" Margin="0,14,0,14" Style="{StaticResource Hint}" />
              <DataGrid ItemsSource="{Binding WifiRows}"><DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text NetworkCandidate}" Binding="{Binding Name}" Width="*" MinWidth="200" />
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Received}" Binding="{Binding Download}" Width="125" />
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Sent}" Binding="{Binding Upload}" Width="125" />
              </DataGrid.Columns></DataGrid>
              <Expander Header="{DynamicResource Details}" Margin="0,16,0,0"><TextBlock Text="{DynamicResource WifiLimits}" Style="{StaticResource Hint}" Margin="0,12,0,0" /></Expander>
              <Expander Header="{DynamicResource RouteEvidence}" Margin="0,14,0,0"><StackPanel Margin="0,12,0,0"><Button Content="{DynamicResource ReadRoutes}" Click="OnReadRoutes" IsEnabled="{Binding CanReadRoutes}" HorizontalAlignment="Left" /><TextBlock Text="{Binding RouteInfo}" Style="{StaticResource Hint}" Margin="0,10,0,0" /></StackPanel></Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="ApplicationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="{Binding Status}" Style="{StaticResource Status}" />
              <WrapPanel Margin="0,14,0,16"><Button Content="{DynamicResource StartApps}" Click="OnStartApplications" IsEnabled="{Binding CanStart}" Margin="0,0,10,6" /><Button Content="{DynamicResource Stop}" Click="OnStopApplications" IsEnabled="{Binding CanStop}" Margin="0,0,0,6" /></WrapPanel>
              <DataGrid ItemsSource="{Binding Rows}"><DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text ApplicationInstance}" Binding="{Binding Name}" Width="*" MinWidth="200" />
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Received}" Binding="{Binding Download}" Width="115" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Sent}" Binding="{Binding Upload}" Width="115" />
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Identity}" Binding="{Binding Identity}" Width="200" />
              </DataGrid.Columns></DataGrid>
              <TextBlock Text="{Binding Quality}" Style="{StaticResource Hint}" Margin="0,14,0,0" />
              <Expander Header="{DynamicResource Details}" Margin="0,16,0,0"><TextBlock Text="{DynamicResource ApplicationLimits}" Style="{StaticResource Hint}" Margin="0,12,0,0" /></Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="ProxyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="{Binding Status}" Style="{StaticResource Status}" />
              <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0"><TextBlock Text="{DynamicResource Controller}" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanStart}" AutomationProperties.Name="{DynamicResource Controller}" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource ProxyPort}" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanStart}" AutomationProperties.Name="{DynamicResource ProxyPort}" /></StackPanel>
              </Grid>
              <TextBlock Text="{DynamicResource Token}" Style="{StaticResource FieldLabel}" />
              <PasswordBox x:Name="ProxySecret" IsEnabled="{Binding CanStart}" AutomationProperties.Name="{DynamicResource Token}" />
              <WrapPanel Margin="0,16,0,12"><Button Content="{DynamicResource FindController}" Click="OnFindProxy" IsEnabled="{Binding CanStart}" Margin="0,0,10,6" /><Button Content="{DynamicResource StartProxy}" Click="OnStartProxy" IsEnabled="{Binding CanStart}" Margin="0,0,10,6" /><Button Content="{DynamicResource StopProxy}" Click="OnStopProxy" IsEnabled="{Binding CanStop}" Margin="0,0,10,6" /></WrapPanel>
              <TextBlock Text="{Binding Version}" Style="{StaticResource Hint}" /><TextBlock Text="{Binding CoreTotal}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,6" /><TextBlock Text="{Binding ConnectionTotal}" Margin="0,0,0,14" />
              <DataGrid ItemsSource="{Binding Rows}" MinHeight="160" MaxHeight="260"><DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text OriginalApp}" Binding="{Binding Application}" Width="*" MinWidth="190" />
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Ingress}" Binding="{Binding Ingress}" Width="125" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Route}" Binding="{Binding Route}" Width="150" />
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Received}" Binding="{Binding Download}" Width="100" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Sent}" Binding="{Binding Upload}" Width="100" />
              </DataGrid.Columns></DataGrid>
              <TextBlock Text="{Binding Quality}" Style="{StaticResource Hint}" Margin="0,14,0,0" />
              <Expander Header="{DynamicResource Details}" Margin="0,14,0,0"><StackPanel Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource ProxyLimits}" Style="{StaticResource Hint}" /><Button Content="{DynamicResource VerifyProxy}" Click="OnVerifyProxy" IsEnabled="{Binding CanVerify}" HorizontalAlignment="Left" Margin="0,14,0,10" />
                <TextBlock Text="{DynamicResource ProxyProbeNote}" Style="{StaticResource Hint}" /><TextBlock x:Name="ProxyValidationResult" Margin="0,8,0,0" />
              </StackPanel></Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="SshPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="{Binding Status}" Style="{StaticResource Status}" />
              <WrapPanel Margin="0,14,0,16"><Button Content="{DynamicResource StartSsh}" Click="OnStartSsh" IsEnabled="{Binding CanStart}" Margin="0,0,10,6" /><Button Content="{DynamicResource Stop}" Click="OnStopSsh" IsEnabled="{Binding CanStop}" /></WrapPanel>
              <DataGrid ItemsSource="{Binding SshRows}" MinHeight="180" MaxHeight="300" RowHeight="60"><DataGrid.Columns>
                <DataGridTemplateColumn Header="{loc:Text Server}" Width="*" MinWidth="190"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <StackPanel ToolTip="{Binding State}"><TextBlock Text="{Binding Alias}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /><TextBlock Text="{Binding Client}" FontSize="12" Foreground="#526C79" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></StackPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Endpoint}" Binding="{Binding Server}" Width="170" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Evidence}" Binding="{Binding Evidence}" Width="130" />
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Received}" Binding="{Binding Download}" Width="100" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Sent}" Binding="{Binding Upload}" Width="100" />
              </DataGrid.Columns></DataGrid>
              <TextBlock Text="{Binding Quality}" Style="{StaticResource Hint}" Margin="0,14,0,0" />
              <Expander Header="{DynamicResource ServerRules}" Margin="0,16,0,0" IsEnabled="{Binding CanStart}"><StackPanel x:Name="SshRulesPanel" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource RulesNote}" Style="{StaticResource Hint}" />
                <Grid Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Address}" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Address}" /></StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="{DynamicResource Port}" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Port}" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Alias}" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Alias}" /></StackPanel>
                </Grid>
                <WrapPanel><Button Content="{DynamicResource AddRule}" Click="OnAddSshRule" Margin="0,0,10,8" /><Button Content="{DynamicResource RemoveRule}" Click="OnRemoveSshRule" Margin="0,0,0,8" /></WrapPanel>
                <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" MinHeight="90" MaxHeight="160"><DataGrid.Columns>
                  <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Address}" Binding="{Binding Address}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Port}" Binding="{Binding Port}" Width="100" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Alias}" Binding="{Binding Alias}" Width="*" />
                </DataGrid.Columns></DataGrid>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
              </StackPanel></Expander>
              <Expander Header="{DynamicResource Details}" Margin="0,14,0,0"><TextBlock Text="{DynamicResource SshLimits}" Style="{StaticResource Hint}" Margin="0,12,0,0" /></Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="ReportsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Grid IsEnabled="{Binding CanQuery}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0"><TextBlock Text="{DynamicResource Ledger}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Streams}" SelectedItem="{Binding SelectedStream}" DisplayMemberPath="Label" AutomationProperties.Name="{DynamicResource Ledger}" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Period}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" AutomationProperties.Name="{DynamicResource Period}" /></StackPanel>
              </Grid>
              <Grid IsEnabled="{Binding CanQuery}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0"><TextBlock Text="{DynamicResource From}" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding FromDate}" AutomationProperties.Name="{DynamicResource From}" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="{DynamicResource Until}" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding UntilDate}" AutomationProperties.Name="{DynamicResource Until}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource TimeZone}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding TimeZones}" SelectedItem="{Binding SelectedTimeZone}" DisplayMemberPath="Id" AutomationProperties.Name="{DynamicResource TimeZone}" /></StackPanel>
              </Grid>
              <WrapPanel Margin="0,18,0,16"><Button Content="{DynamicResource QueryReport}" Click="OnQueryReport" IsEnabled="{Binding CanQuery}" Margin="0,0,10,6" /><Button Content="{DynamicResource RefreshLedgers}" Click="OnRefreshLedgers" IsEnabled="{Binding CanQuery}" Margin="0,0,10,6" /><Button Content="{DynamicResource ExportCsv}" Click="OnExportCsv" IsEnabled="{Binding CanExport}" Margin="0,0,0,6" /></WrapPanel>
              <TextBlock Text="{Binding ReportStatus}" Style="{StaticResource Status}" Margin="0,0,0,14" />
              <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{Binding Total}" FontSize="23" LineHeight="32" FontWeight="SemiBold" /><TextBlock Text="{Binding ReportDetails}" Style="{StaticResource Hint}" Margin="0,8,0,0" /></StackPanel></Border>
              <DataGrid ItemsSource="{Binding Rows}" Margin="0,8,0,0"><DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text PeriodStart}" Binding="{Binding Period}" Width="125" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Entity}" Binding="{Binding Entity}" Width="*" MinWidth="180" />
                <DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Received}" Binding="{Binding Download}" Width="105" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Sent}" Binding="{Binding Upload}" Width="105" /><DataGridTextColumn ElementStyle="{StaticResource TableText}" Header="{loc:Text Quality}" Binding="{Binding Quality}" Width="110" />
              </DataGrid.Columns></DataGrid>
              <Expander Header="{DynamicResource Details}" Margin="0,16,0,0"><TextBlock Text="{DynamicResource ReportLimits}" Style="{StaticResource Hint}" Margin="0,12,0,0" /></Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="EnvironmentPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="{DynamicResource Storage}" FontSize="20" FontWeight="SemiBold" />
              <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Margin="0,14,0,12" AutomationProperties.Name="{DynamicResource Storage}" />
              <TextBlock Text="{DynamicResource StorageNote}" Style="{StaticResource Hint}" />
              <TextBlock Text="{DynamicResource CoverageNote}" Style="{StaticResource Hint}" Margin="0,16,0,24" />
              <Button Content="{DynamicResource CheckEnvironment}" HorizontalAlignment="Left" Click="OnCheckEnvironment" />
              <TextBlock x:Name="EnvironmentResult" Text="{DynamicResource NotChecked}" Margin="0,20,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
      <TextBlock x:Name="StorageStatus" Grid.Row="2" Text="{Binding Status}" Margin="2,12,0,0" Style="{StaticResource Hint}" />
    </Grid>
  </Grid>
</Window>
