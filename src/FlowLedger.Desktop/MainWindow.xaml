<Window x:Class="FlowLedger.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowLedger · 流量簿 · 代理关联" Width="1080" Height="740"
        MinWidth="940" MinHeight="640" Background="#F3F6F8" Foreground="#17323D"
        WindowStartupLocation="CenterScreen" Icon="Assets/FlowLedger.ico">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#142D37">
      <Grid Margin="24,36,24,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <Image Source="Assets/FlowLedger.png" Width="64" Height="64"
                 HorizontalAlignment="Left" Margin="0,0,0,16"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 AutomationProperties.Name="FlowLedger 标志：双向数据流与账本" />
          <TextBlock Text="FlowLedger" FontSize="27" FontWeight="SemiBold" Foreground="#8FE2CB" />
          <TextBlock Text="流量簿" FontSize="16" Foreground="#D7E5EB" Margin="0,8,0,36" />
        </StackPanel>
        <ListBox x:Name="NavigationList" Grid.Row="1" Background="Transparent"
                 BorderThickness="0" SelectionChanged="OnNavigationChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Foreground" Value="#D7E5EB" />
              <Setter Property="FontSize" Value="16" />
              <Setter Property="Padding" Value="14,13" />
              <Setter Property="Margin" Value="0,0,0,6" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBackground" Padding="{TemplateBinding Padding}" CornerRadius="8">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemBackground" Property="Background" Value="#28514F" />
                        <Setter Property="Foreground" Value="#B3F5DF" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="ItemBackground" Property="BorderBrush" Value="#8FE2CB" />
                        <Setter TargetName="ItemBackground" Property="BorderThickness" Value="1" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBoxItem Content="总览" />
          <ListBoxItem Content="网络账本" />
          <ListBoxItem Content="应用统计" />
          <ListBoxItem Content="代理账本" />
          <ListBoxItem Content="远程连接" />
          <ListBoxItem Content="运行环境" />
        </ListBox>
        <StackPanel Grid.Row="2">
          <TextBlock Text="开发预览" FontSize="13" Foreground="#8FE2CB" />
          <TextBlock Text="v0.1 · 代理关联验证" Margin="0,6,0,0" FontSize="12" Foreground="#A9BEC7" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="36,36,36,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock x:Name="PageTitle" FontSize="30" FontWeight="SemiBold" />
        <TextBlock x:Name="PageDescription" FontSize="14" Foreground="#607885"
                   Margin="0,12,0,28" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Row="1" Background="#E4F3ED" CornerRadius="10" Padding="18,14" Margin="0,0,0,24">
        <TextBlock Text="{Binding CollectionStatus}" Foreground="#245B4E"
                   FontSize="14" TextWrapping="Wrap" />
      </Border>
      <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="24" BorderBrush="#DEE7EB" BorderThickness="1">
        <Grid>
          <ScrollViewer x:Name="TrafficPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="选择网络接口" FontSize="16" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                        DisplayMemberPath="Label" Margin="0,10,0,0" Padding="10,8" FontSize="14"
                        AutomationProperties.Name="选择网络接口" />
              <TextBlock Text="{Binding InventorySummary}" Foreground="#607885" Margin="0,8,0,18"
                         TextWrapping="Wrap" FontSize="12" />
              <UniformGrid Columns="2">
                <StackPanel Margin="0,0,12,14">
                  <TextBlock Text="下载速度" Foreground="#607885" />
                  <TextBlock Text="{Binding DownloadRate}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                  <TextBlock Text="上传速度" Foreground="#607885" />
                  <TextBlock Text="{Binding UploadRate}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,12,16">
                  <TextBlock Text="本次运行 · 下载" Foreground="#607885" />
                  <TextBlock Text="{Binding DownloadTotal}" FontSize="23" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,0,16">
                  <TextBlock Text="本次运行 · 上传" Foreground="#607885" />
                  <TextBlock Text="{Binding UploadTotal}" FontSize="23" Margin="0,6,0,0" />
                </StackPanel>
              </UniformGrid>
              <TextBlock Text="{Binding QualityStatus}" TextWrapping="Wrap" LineHeight="22" FontSize="12" />
              <Expander Header="接口与 Wi-Fi 信息" Margin="0,16,0,0" IsExpanded="False">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Text="{Binding SelectionDetails}" TextWrapping="Wrap" LineHeight="22" Foreground="#607885" FontSize="12" />
                  <Button Content="查询所选 Wi-Fi 名称" IsEnabled="{Binding CanReadWifi}" Click="OnReadWifi"
                          HorizontalAlignment="Left" Margin="0,12,0,10" />
                  <TextBlock Text="{Binding WifiInfo}" TextWrapping="Wrap" LineHeight="22" FontSize="12" />
                  <TextBlock Text="此操作只读取当前连接；Windows 可能提示位置权限。"
                             TextWrapping="Wrap" Foreground="#607885" Margin="0,6,0,0" FontSize="12" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="WifiLedgerPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="{Binding WifiModeStatus}" TextWrapping="Wrap" LineHeight="22" />
              <WrapPanel Margin="0,12,0,16">
                <Button Content="启用 Wi-Fi 分账" Click="OnEnableWifi" IsEnabled="{Binding CanEnableWifi}" Margin="0,0,10,6" />
                <Button Content="暂停分账" Click="OnDisableWifi" IsEnabled="{Binding CanDisableWifi}" Margin="0,0,0,6" />
              </WrapPanel>
              <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                        DisplayMemberPath="Label" Padding="10,8" FontSize="14" AutomationProperties.Name="选择分账接口" />
              <TextBlock Text="{Binding WifiAllocationSummary}" TextWrapping="Wrap" Margin="0,12,0,12" LineHeight="22" FontSize="12" />
              <DataGrid ItemsSource="{Binding WifiRows}" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" MaxHeight="220" MinHeight="100" BorderBrush="#DEE7EB"
                        AutomationProperties.Name="本次 Wi-Fi 分账记录">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="网络候选 / 归属状态" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="下载" Binding="{Binding Download}" Width="110" />
                  <DataGridTextColumn Header="上传" Binding="{Binding Upload}" Width="110" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="依据系统提供的网络信息区分候选，同名网络仍可能无法分辨。更换接入点不会自动拆成新账本，切换边界单列。通知或身份不足时保留为未识别；关闭软件后记录丢失。"
                         TextWrapping="Wrap" Foreground="#607885" FontSize="12" LineHeight="22" Margin="0,12,0,0" />
              <Expander Header="检查出口关系" Margin="0,14,0,0">
                <StackPanel Margin="0,10,0,0">
                  <Button Content="读取路由关系" Click="OnReadRoutes" IsEnabled="{Binding CanReadRoutes}" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding RouteInfo}" TextWrapping="Wrap" FontSize="12" LineHeight="22" Margin="0,10,0,0" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="ApplicationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" LineHeight="22" />
              <WrapPanel Margin="0,12,0,16">
                <Button Content="开始应用统计" Click="OnStartApplications" IsEnabled="{Binding CanStart}" Margin="0,0,10,6" />
                <Button Content="停止应用统计" Click="OnStopApplications" IsEnabled="{Binding CanStop}" Margin="0,0,0,6" />
              </WrapPanel>
              <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" MaxHeight="290" MinHeight="120" BorderBrush="#DEE7EB"
                        AutomationProperties.Name="本次应用统计记录">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="应用 / 进程实例" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="接收" Binding="{Binding Download}" Width="90" />
                  <DataGridTextColumn Header="发送" Binding="{Binding Upload}" Width="90" />
                  <DataGridTextColumn Header="身份依据" Binding="{Binding Identity}" Width="145" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="{Binding Quality}" TextWrapping="Wrap" Foreground="#607885" FontSize="12"
                         LineHeight="22" Margin="0,12,0,0" />
              <TextBlock Text="TCP/UDP · IPv4/IPv6。每个进程实例单独保留，同名软件可能有多行。受控本机回环已验证；不代表公网精度或长期稳定性，不是互联网出口账单。停止保留记录，再次开始清空；关闭后丢失。"
                         TextWrapping="Wrap" Foreground="#607885" FontSize="12" LineHeight="22" Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="ProxyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" LineHeight="22" />
              <TextBlock Text="控制器地址（本机回环 IP）" Margin="0,14,0,4" />
              <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanStart}" AutomationProperties.Name="本机控制器地址" />
              <TextBlock Text="控制器密钥（只在内存中使用，不保存）" Margin="0,10,0,4" />
              <PasswordBox x:Name="ProxySecret" IsEnabled="{Binding CanStart}" AutomationProperties.Name="控制器密钥，仅本次运行" />
              <TextBlock Text="代理入口端口（HTTP / mixed）" Margin="0,10,0,4" />
              <TextBox Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanStart}" AutomationProperties.Name="代理入口端口" />
              <WrapPanel Margin="0,12,0,12">
                <Button Content="查找本机控制器" Click="OnFindProxy" IsEnabled="{Binding CanStart}" Margin="0,0,10,6" />
                <Button Content="启用代理观察" Click="OnStartProxy" IsEnabled="{Binding CanStart}" Margin="0,0,10,6" />
                <Button Content="停止观察" Click="OnStopProxy" IsEnabled="{Binding CanStop}" Margin="0,0,10,6" />
                <Button Content="验证本机代理" Click="OnVerifyProxy" IsEnabled="{Binding CanVerify}" Margin="0,0,0,6" />
              </WrapPanel>
              <TextBlock Text="{Binding Version}" Foreground="#607885" />
              <TextBlock Text="{Binding CoreTotal}" FontWeight="SemiBold" Margin="0,10,0,6" />
              <TextBlock Text="{Binding ConnectionTotal}" Margin="0,0,0,12" />
              <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                        MaxHeight="220" MinHeight="100" HeadersVisibility="Column" AutomationProperties.Name="代理连接增量，不含 ETW 叠加">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="原应用 / 归属" Binding="{Binding Application}" Width="*" />
                  <DataGridTextColumn Header="入站" Binding="{Binding Ingress}" Width="130" />
                  <DataGridTextColumn Header="路径证据" Binding="{Binding Route}" Width="145" />
                  <DataGridTextColumn Header="下载" Binding="{Binding Download}" Width="85" />
                  <DataGridTextColumn Header="上传" Binding="{Binding Upload}" Width="85" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="{Binding Quality}" TextWrapping="Wrap" FontSize="12" LineHeight="22" Foreground="#607885" Margin="0,12,0,0" />
              <TextBlock Text="TCP 归属要求 API 两侧的本机连接与进程实例证据一致；UDP、短连接或 TUN 地址不匹配时保留未知。不会按名称猜测或直接从 ETW 总量扣除代理字节。"
                         TextWrapping="Wrap" FontSize="12" LineHeight="22" Foreground="#607885" Margin="0,8,0,0" />
              <TextBlock Text="本机验证会产生约 1 MiB 回环响应，不访问外部服务器、不修改代理规则。" TextWrapping="Wrap" FontSize="12" Foreground="#607885" Margin="0,8,0,0" />
              <TextBlock x:Name="ProxyValidationResult" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" MaxWidth="500">
            <TextBlock Text="等待首次记录" FontSize="25" FontWeight="SemiBold" />
            <TextBlock x:Name="EmptyDescription" FontSize="15" Foreground="#607885"
                       Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="26" />
          </StackPanel>
          <StackPanel x:Name="EnvironmentPanel" Visibility="Collapsed">
            <TextBlock Text="本机运行环境" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="只读取系统版本和接口分类数量，不读取 Wi-Fi 名称或连接地址。"
                       TextWrapping="Wrap" Foreground="#607885" Margin="0,12,0,20" LineHeight="24" />
            <Button Content="检查运行环境" HorizontalAlignment="Left" Click="OnCheckEnvironment" />
            <TextBlock x:Name="EnvironmentResult" Text="尚未检查" Margin="0,24,0,0"
                       TextWrapping="Wrap" FontSize="14" LineHeight="26" />
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock Grid.Row="3" Text="当前记录仅在内存中；代理关联为实验功能，历史报表和 SSH 归属待开发。"
                 Margin="0,22,0,0" FontSize="12" Foreground="#607885" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
